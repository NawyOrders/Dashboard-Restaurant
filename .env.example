# Copy this file to `.env` for local development.
# `.env` is gitignored; never commit real credentials.
#
# Leave VITE_API_BASE_URL empty in production: the dashboard derives
# https://{slug}.api.nawyorders.com from the request hostname
# ({slug}.admin.nawyorders.com). Set it only to override the tenant API in
# local development, Vitest or Playwright (HTTPS, no embedded credentials).
VITE_API_BASE_URL=
VITE_LOGIN_OWNER_EMAIL=
VITE_LOGIN_MANAGER_EMAIL=
VITE_LOGIN_STAFF_EMAIL=
VITE_LOGIN_PASSWORD=
